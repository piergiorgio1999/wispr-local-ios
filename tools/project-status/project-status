#!/usr/bin/env bash
set -Eeuo pipefail

FORMAT="md"
MODE="status"
REPO=""

usage() {
    echo "Usage: project-status [diagnose] [md|json] [--repo OWNER/REPO]" >&2
}

while (($#)); do
    case "$1" in
        diagnose) MODE="diagnose" ;;
        md|json) FORMAT="$1" ;;
        --repo)
            (($# >= 2)) || { usage; exit 2; }
            REPO="$2"
            shift
            ;;
        -h|--help) usage; exit 0 ;;
        *) usage; exit 2 ;;
    esac
    shift
done

command -v jq >/dev/null 2>&1 || { echo "project-status: jq is required" >&2; exit 1; }

gh_with_repo() {
    if [[ -n "$REPO" ]]; then
        gh "$@" --repo "$REPO"
    else
        gh "$@"
    fi
}

run_gh() {
    if [[ -n "${PROJECT_STATUS_MOCK_DIR:-}" ]]; then
        case "$1" in
            issues) cat "$PROJECT_STATUS_MOCK_DIR/issues.json" ;;
            prs) cat "$PROJECT_STATUS_MOCK_DIR/prs.json" ;;
            repo) printf '%s\n' "${PROJECT_STATUS_MOCK_REPOSITORY:-fixture/repository}" ;;
        esac
        return
    fi
    case "$1" in
        issues) gh_with_repo issue list --state all --limit 1000 --json number,title,state,labels,milestone,subIssues,blockedBy,blocking ;;
        prs) gh_with_repo pr list --state all --limit 1000 --json number,title,state,labels,closingIssuesReferences,statusCheckRollup,mergeStateStatus,headRefOid ;;
        repo)
            if [[ -n "$REPO" ]]; then
                gh repo view "$REPO" --json nameWithOwner --jq '.nameWithOwner'
            else
                gh repo view --json nameWithOwner --jq '.nameWithOwner'
            fi
            ;;
    esac
}

if [[ -n "${PROJECT_STATUS_MOCK_DIR:-}" ]]; then
    issues_json="$(run_gh issues)"
    prs_json="$(run_gh prs)"
else
    command -v gh >/dev/null 2>&1 || { echo "project-status: gh is required" >&2; exit 1; }
    if prs_json="$(run_gh prs 2>/dev/null)"; then
        :
    else
        echo "project-status: closingIssuesReferences unavailable; using PR label fallback" >&2
        prs_json="$(gh_with_repo pr list --state all --limit 1000 --json number,title,state,labels,statusCheckRollup,mergeStateStatus,headRefOid)"
    fi
    if issues_json="$(run_gh issues 2>/dev/null)"; then
        issue_features=true
    else
        issue_features=false
        issues_json="$(gh_with_repo issue list --state all --limit 1000 --json number,title,state,labels,milestone)"
    fi
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT
printf '%s\n' "$issues_json" >"$tmpdir/issues.json"
printf '%s\n' "$prs_json" >"$tmpdir/prs.json"

diagnostics='[]'
if [[ "$MODE" == "diagnose" ]]; then
    if [[ -n "${PROJECT_STATUS_MOCK_DIR:-}" ]]; then
        diagnostics="$(jq '[.[].diagnostics[]?]' "$PROJECT_STATUS_MOCK_DIR/prs.json")"
    else
        diagnostics_file="$tmpdir/diagnostics.jsonl"
        : >"$diagnostics_file"
        # jq variables in the nested filter are intentionally protected from Bash expansion.
        # shellcheck disable=SC2016
        while IFS=$'\t' read -r pr_number run_id; do
            [[ -n "$run_id" ]] || continue
            run="$(gh_with_repo run view "$run_id" --json name,url)"
            [[ -n "$run" ]] || continue
            while IFS=$'\t' read -r job_id job_name step_name; do
                job_log="$(gh_with_repo run view "$run_id" --job "$job_id" --log-failed 2>/dev/null || true)"
                clean_log="$(printf '%s\n' "$job_log" | awk '
                    BEGIN { esc = sprintf("%c", 27) }
                    {
                        sub(/\r$/, "")
                        gsub(esc "\\[[0-?]*[ -/]*[@-~]", "")
                        gsub(esc "[@-_]", "")
                        gsub("\\^\\[\\[[0-?]*[ -/]*[@-~]", "")
                        print
                    }
                ')"
                messages="$(printf '%s\n' "$clean_log" | awk -F '\t' '
                    NF >= 3 {
                        message = $3
                        for (i=4; i<=NF; i++) message = message FS $i
                        sub(/^[^[:space:]]+[[:space:]]+/, "", message)
                        print message
                        next
                    }
                    { print }
                ')"
                error_line="$(printf '%s\n' "$messages" | grep -E -m1 'error\[[^]]+\]:|(^|[[:space:]])(error:|ERROR|Error:|fatal:|FAIL([:[:space:]]|$)|❌)' | grep -Ev 'Process completed with exit code' || true)"
                error="$error_line"
                if [[ "$error" == *'error['* ]]; then
                    detail="$(printf '%s\n' "$messages" | grep -E -m1 'pull_request_target|workflow_call|workflow_run' || true)"
                    if [[ -n "$detail" && "$error" != *"$detail"* ]]; then
                        error="$error; $detail"
                    fi
                fi
                error="$(printf '%s' "$error" | cut -c1-300)"
                error="${error:-failed step; inspect targeted job log}"
                location="$(printf '%s\n' "$messages" | grep -Eo '[[:alnum:]_./-]+\.[[:alnum:]_+-]+:[0-9]+(:[0-9]+)?' | head -n1 || true)"
                if [[ "$error" == "failed step; inspect targeted job log" ]]; then
                    escalation="FIX: inspect the failed step; load the targeted job log only if this digest is insufficient"
                else
                    escalation="FIX: address the reported failure"
                fi
                if [[ "$error" == *pending* || "$error" == *incomplete* ]]; then
                    escalation="WAIT: external check incomplete"
                fi
                jq -cn --argjson pr "$pr_number" --arg workflow "$(jq -r '.name' <<<"$run")" \
                    --arg job "$job_name" --arg step "$step_name" --arg error "$error" \
                    --arg location "$location" --arg url "$(jq -r '.url' <<<"$run")" --arg escalation "$escalation" \
                    '{pr:$pr,workflow:$workflow,job:$job,step:$step,error:$error,location:($location | if length > 0 then . else null end),url:$url,escalation:$escalation}' \
                    >>"$diagnostics_file"
            done < <(gh_with_repo run view "$run_id" --json jobs --jq '
              [.jobs[] | select(.conclusion == "failure")] as $failed |
              $failed[] |
              select(.name != "CI Gate" or ([$failed[] | select(.name != "CI Gate")] | length) == 0) |
              [.databaseId,.name,([.steps[] | select(.conclusion == "failure") | .name][0] // "unknown")] | @tsv
            ')
        done < <(jq -r '
          def check_key: [(.workflowName // ""), (.name // .context // "unnamed")];
          def current_checks: group_by(check_key) | map(sort_by(.startedAt // .completedAt // "") | last);
          .[] | select(.state == "OPEN") | .number as $pr |
          ((.statusCheckRollup // []) | current_checks[]) |
          select(((.conclusion // .state // "") | ascii_upcase) | IN("FAILURE","ERROR","CANCELLED","TIMED_OUT","ACTION_REQUIRED")) |
          (.detailsUrl // "" | capture("/actions/runs/(?<id>[0-9]+)")?.id) as $run_id |
          select($run_id != null) | [$pr,$run_id] | @tsv
        ' <<<"$prs_json" | sort -u)
        diagnostics="$(jq -s '.' "$diagnostics_file")"
    fi
fi

repo="$(run_gh repo)"
generated_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"

digest="$(jq -n \
    --arg repository "$repo" \
    --arg generated_at "$generated_at" \
    --slurpfile issues_file "$tmpdir/issues.json" \
    --slurpfile prs_file "$tmpdir/prs.json" \
    --argjson issue_features "${issue_features:-true}" \
    --argjson diagnostics "$diagnostics" \
    --argjson diagnose "$([[ "$MODE" == "diagnose" ]] && echo true || echo false)" '
  ($issues_file[0]) as $issues |
  ($prs_file[0]) as $prs |
  def labels: (.labels // []) | map(if type == "object" then .name else . end);
  def subissues: if (.subIssues | type) == "object" then (.subIssues.nodes // []) else (.subIssues // []) end;
  def blocked_by: if (.blockedBy | type) == "object" then (.blockedBy.nodes // []) else (.blockedBy // []) end;
  def priority: (labels | map(select(test("^priority:P[012]$"))) | first // "priority:none");
  def check_key: [(.workflowName // ""), (.name // .context // "unnamed")];
  def current_checks: group_by(check_key) | map(sort_by(.startedAt // .completedAt // "") | last);
  def issue_number: .number;
  def linked_prs($issue): [$prs[] | select(.state == "OPEN") | select([.closingIssuesReferences[]?.number] | index($issue))];
  def is_blocked: ((blocked_by | length) > 0) or ((labels | index("status:blocked")) != null);
  def issue_attention: ((labels | index("status:attention")) != null);
  def check_failed: ([((.statusCheckRollup // []) | current_checks[]) | (.conclusion // .state // "") | ascii_upcase | IN("FAILURE", "ERROR", "CANCELLED", "TIMED_OUT")] | any);
  def attention($pr): ((labels | index("status:attention")) != null) or ($pr.mergeStateStatus == "CONFLICTING") or ($pr.check_failed);
  def check_icon:
    . as $check |
    (($check.conclusion // $check.state // "") | ascii_downcase) as $outcome |
    if $outcome == "success" then "🟢"
    elif ($outcome == "skipped" or $outcome == "neutral" or $outcome == "not_applicable") then "⚪"
    else "🔴" end;
  def check_label:
    . as $check |
    ($check | check_icon) as $icon |
    (($check.name // $check.context // "unnamed") + " " + $icon + " " + (($check.conclusion // $check.state // "unknown") | ascii_downcase));
  def pr_diagnosis:
    if ([((.statusCheckRollup // []) | current_checks[]) | . as $check | select(((($check.status // "") | ascii_downcase) != "completed") and (($check.conclusion // "") == "" or $check.conclusion == null))] | length) > 0 then "WAIT: external check incomplete"
    elif ([((.statusCheckRollup // []) | current_checks[]) | ((.conclusion // .state // "") | ascii_downcase) | select(. == "failure" or . == "error" or . == "cancelled" or . == "timed_out" or . == "action_required")] | length) > 0 then "FIX: check failure"
    else "PASS: checks complete" end;
  def issue_text: ("#" + (.number|tostring) + " " + .title);
  def milestone_progress:
    [ $issues[] | select(.milestone != null) | .milestone.title ] | unique | map(. as $m |
      {title: $m, closed: ([$issues[] | select(.milestone.title == $m and .state == "CLOSED")] | length), total: ([$issues[] | select(.milestone.title == $m)] | length)});
  def feature_progress:
    [$issues[] | select((subissues | length) > 0)] | map(. as $feature |
      {issue: ($feature | issue_text), closed: ([$feature | subissues[] | select(.state == "CLOSED")] | length), total: (($feature | subissues) | length)});
  ($issues | map(select(.state == "CLOSED") | issue_text)) as $done |
  ($issues | map(select(.state == "OPEN") | select(is_blocked | not) | select(issue_attention | not) | select((linked_prs(.number) | length) > 0))) as $current_issues |
  ($current_issues | map(issue_text)) as $current |
  ([$current_issues[] as $issue | linked_prs($issue.number)[] | {issue: ("#" + ($issue.number|tostring)), pr: ("#" + (.number|tostring)), checks: [((.statusCheckRollup // []) | current_checks[]) | check_label], diagnosis: pr_diagnosis}]) as $current_prs |
  ($issues | map(select(.state == "OPEN") | select(is_blocked) | issue_text)) as $blocked |
  ($issues | map(select(.state == "OPEN") | select(is_blocked) | .number)) as $blocked_numbers |
  ($issues | map(select(.state == "OPEN") | select(is_blocked | not) | select(issue_attention) | issue_text)) as $label_attention |
  ($prs | map(select(.state == "OPEN") | select(any(.closingIssuesReferences[]?; true)) | select(attention(.)) | select(any(.closingIssuesReferences[]?.number; . as $n | ($blocked_numbers | index($n)) == null)) | "PR #" + (.number|tostring) + " " + .title)) as $pr_attention |
  ($issues | map(select(.state == "OPEN") | select((linked_prs(.number) | length) == 0) | select(is_blocked | not) | select(issue_attention | not) | {text: issue_text, priority: priority, number: .number}) | sort_by((if .priority == "priority:P0" then 0 elif .priority == "priority:P1" then 1 elif .priority == "priority:P2" then 2 else 3 end), .number) | map(.text)) as $next |
  ({repository: $repository, generated_at: $generated_at, phase: "V1", progress: {milestones: milestone_progress, features: feature_progress}, current: ($current | sort), current_prs: $current_prs, done: ($done | sort), next: $next, blocked: ($blocked | sort), attention: (($label_attention + $pr_attention) | unique | sort)} + if $diagnose then {ci_diagnostics: $diagnostics} else {} end)
  ' )"

if [[ "$FORMAT" == "json" ]]; then
    jq . <<<"$digest"
else
    markdown="$(jq -r '
      def list_or_none: if length == 0 then "none" else join("\n") end;
      (["# Project Status", "", "Repository: \(.repository)", "Generated: \(.generated_at)", "Phase: \(.phase)", "", "## Progress", (.progress | tostring), "", "## Current", (.current | list_or_none), "", "## Current PR", (if (.current_prs | length) == 0 then "none" else (.current_prs[] | [.pr, "", (.checks | join("\n")), "", .diagnosis] | join("\n")) end)] + (if has("ci_diagnostics") then ["", "## CI Diagnostics", (if (.ci_diagnostics | length) == 0 then "none" else (.ci_diagnostics[] | ["PR #\(.pr) — \(.workflow)", "- Job: \(.job)", "- Step: \(.step)", "- Error: \(.error)", (if .location then "- Location: \(.location)" else empty end), "- Escalation: \(.escalation)"] | join("\n")) end)] else [] end) + ["", "## Next", (.next | list_or_none), "", "## Blocked", (.blocked | list_or_none), "", "## Attention", (.attention | list_or_none)]) | join("\n")
    ' <<<"$digest")"
    lines="$(printf '%s\n' "$markdown" | wc -l | tr -d ' ')"
    if (( lines > 100 )); then
        markdown="$(printf '%s\n' "$markdown" | awk 'NR < 100 { print } NR == 100 { print "… truncated"; exit }')"
    fi
    bytes="$(printf '%s' "$markdown" | wc -c | tr -d ' ')"
    if (( bytes > 8192 )); then
        marker='… truncated'
        marker_bytes="$(printf '%s' "$marker" | wc -c | tr -d ' ')"
        prefix_bytes=$((8192 - marker_bytes))
        prefix="$(printf '%s' "$markdown" | LC_ALL=C head -c "$prefix_bytes" | iconv -f UTF-8 -t UTF-8 -c)"
        markdown="${prefix}${marker}"
    fi
    printf '%s\n' "$markdown"
fi
