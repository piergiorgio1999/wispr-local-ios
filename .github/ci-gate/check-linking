#!/usr/bin/env bash
set -Eeuo pipefail

: "${PR_AUTHOR_LOGIN:?PR_AUTHOR_LOGIN is required}"
: "${PR_BODY?PR_BODY is required}"
: "${PR_CLOSING_REFERENCES_JSON:?PR_CLOSING_REFERENCES_JSON is required}"

jq -e 'type == "array"' >/dev/null <<<"$PR_CLOSING_REFERENCES_JSON" \
    || { echo "linking: closingIssuesReferences is not an array" >&2; exit 1; }

declared_refs="$(grep -Eio '(close[sd]?|fix(e[sd])?|resolve[sd]?)[[:space:]:]+#[0-9]+' <<<"$PR_BODY" \
    | grep -Eo '#[0-9]+' | sort -u | paste -sd, - || true)"
recognized_refs="$(jq -r '.[].number | "#\(.)"' <<<"$PR_CLOSING_REFERENCES_JSON" | sort -u | paste -sd, -)"
declared_refs="${declared_refs:-none}"
recognized_refs="${recognized_refs:-none}"

case "$PR_AUTHOR_LOGIN" in
    dependabot[[]bot])
        echo "linking: static bot allowlist exemption"
        exit 0
        ;;
esac

if [[ "$(jq 'length' <<<"$PR_CLOSING_REFERENCES_JSON")" -ne 1 ]]; then
    echo "linking: exactly one closing issue reference is required" >&2
    echo "linking: declared in PR body: $declared_refs" >&2
    echo "linking: recognized by GitHub: $recognized_refs" >&2
    if [[ "$declared_refs" != "none" ]]; then
        candidate="${declared_refs%%,*}"
        echo "linking: ACTION use a standalone canonical closing clause, for example: Fixes $candidate" >&2
    else
        echo "linking: ACTION add exactly one standalone canonical closing clause: Fixes #ISSUE" >&2
    fi
    exit 1
fi

echo "linking: exactly one closing issue reference found ($recognized_refs)"
